{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)pi/settings\\.json$/"
      ],
      "matchStrings": [
        "\"npm:(?<depName>(?:@[^\"@/]+/)?[^\"@/]+)@(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "pi extensions",
      "groupSlug": "pi-extensions",
      "automerge": false
    }
  ]
}
