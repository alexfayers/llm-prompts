{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 4,
  "automerge": true,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)pi/settings\\.json$/"
      ],
      "matchStrings": [
        "\"npm:(?<depName>(?:@[^\"@/]+/)?[^\"@/]+)@(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "matchManagers": [
        "!github-actions",
        "!custom.regex"
      ],
      "groupName": "major updates",
      "groupSlug": "major-updates",
      "addLabels": [
        "needs-review"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "pi extensions",
      "groupSlug": "pi-extensions",
      "addLabels": [
        "needs-review"
      ]
    }
  ]
}
